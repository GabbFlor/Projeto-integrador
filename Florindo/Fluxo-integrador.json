    {
        "id": "96588cd8e6ee20b6",
        "type": "function",
        "z": "2def2608a0183bd8",
        "name": "Formatar HTML",
        "func": "let dados = msg.payload;\n\n// Essa funciton tira a formatação padrão q vem do banco por conta do formato \"DATE\" da coluna\nfunction formatarData(data) {\n    return new Date(data).toISOString().split('T')[0];\n}\n\nlet html = `\n    <table>\n        <thead>\n            <tr>\n                <th>Id</th>\n                <th>Tipo</th>\n                <th>Peso</th>\n                <th>Preço</th>\n                <th>Data da encomenda</th>\n                <th>Sob-encomenda</th>\n            </tr>\n        </thead>\n\n        <tbody>\n            <tr>`;\nfor (let linha of dados) {\n    // html += é igual a \"html = html + ...\"\n    html += `\n                        <tr>\n                            <td>${linha.id_produto}</td>\n                            <td>${linha.tipo}</td>\n                            <td>${linha.peso}kg</td>\n                            <td>${linha.preco}R$</td>\n                            <td>${formatarData(linha.data_fabricacao)}</td>\n                            <td>${linha.sob_encomenda == 1 ? (\"Sim\") : (\"Não\")}</td>\n                        <tr>\n                    `;\n};\n`</tr>\n        </tbody>\n    </table>\n`\n\nmsg.payload = html;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 500,
        "wires": [
