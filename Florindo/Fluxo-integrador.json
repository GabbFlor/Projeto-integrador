        "name": "UPDATE",
        "func": "let tipo = msg.payload[\"tipo\"];\nlet peso = msg.payload[\"peso\"];\nlet preco = msg.payload[\"preco\"];\nlet sob_encomenda = msg.payload[\"sob-encomenda\"];\nlet id_produto = msg.payload[\"id_produto\"];\n\nlet data = new Date().toISOString().slice(0, 10);\n\nmsg.topic = `\nUPDATE produto \nSET peso = ${peso}, tipo = '${tipo}', preco = ${preco}, sob_encomenda = ${sob_encomenda}\nWHERE id_produto = ${id_produto};\n`;\n\nreturn msg;",
