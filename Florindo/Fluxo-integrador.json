        "format": "<style>\n    table {\n        text-align: center;\n        border-collapse :collapse;\n        font-family: Arial;\n        font-size: 14px;\n    }\n\n    table thead {\n        background-color: #b8696b;\n        color: white;\n    }\n\n    table thead tr th, table tbody tr td {\n        border: 1px solid black;\n        padding: 7.5px;\n        \n    }\n\n    .div-table {\n        display: inline-flex;\n        justify-content: center;\n    }\n</style>\n\n<div ng-bind-html=\"msg.payload\"></div>",
