        "func": "let tipo = msg.payload[\"tipo\"];\nlet peso = msg.payload[\"peso\"];\nlet preco = msg.payload[\"preco\"];\nlet sob_encomenda = msg.payload[\"sob-encomenda\"];\n\nlet data = new Date().toISOString().slice(0, 10);\n\nmsg.topic = `\nINSERT INTO produto (peso, tipo, preco, data_fabricacao, sob_encomenda) VALUES\n(${peso}, '${tipo}', ${preco}, '${data}', ${sob_encomenda});\n`;\n\nreturn msg;",
